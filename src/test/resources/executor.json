{
  "name": "GitHub Actions",
  "type": "CI",
  "url": "https://github.com/victoria198611/ParabankAPITests/actions",
  "buildName": "API Tests and Deploy Allure Report",
  "buildUrl": "https://github.com/victoria198611/ParabankAPITests/actions/runs",
  "reportUrl": "https://victoria198611.github.io/ParabankAPITests",
  "executor": "Victoria"
}

  {
    "name": "Environment Blocked",
    "matchedStatuses": ["skipped"],
    "messageRegex": ".*Cloudflare.*"
  },
  {
    "name": "Assertion Errors",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*AssertionError.*",
    "traceRegex": ".*AssertionError.*"
  },
  {
    "name": "Timeouts",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*Timeout.*",
    "traceRegex": ".*Timeout.*"
  },
  {
    "name": "Connection Issues",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*Connection.*",
    "traceRegex": ".*Connection.*"
  },
  {
    "name": "Other Errors",
    "matchedStatuses": ["failed"]
  }
